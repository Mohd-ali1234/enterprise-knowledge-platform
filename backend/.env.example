# Copy to `.env` and adjust. Every value has a working default, so the service
# runs with no .env at all. See app/core/config.py for the full list.

# ── Application ──────────────────────────────────────────────────
APP_NAME="Enterprise Knowledge Intelligence Platform"
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# JSON array of allowed browser origins
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Chunking ─────────────────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=75

# ── Archive ingestion (Notion / Confluence exports) ──────────────
ARCHIVE_MAX_MEMBERS=2000
ARCHIVE_MAX_UNCOMPRESSED_BYTES=268435456

# ── Web page ingestion ───────────────────────────────────────────
WEB_FETCH_TIMEOUT_SECONDS=30
WEB_FETCH_MAX_BYTES=10485760
WEB_FETCH_USER_AGENT=EKIP-Ingestion/1.0
# Leave false in any shared deployment: the server fetches URLs supplied by
# clients, and enabling this lets them reach localhost and metadata endpoints.
WEB_FETCH_ALLOW_PRIVATE_HOSTS=false

# ── Knowledge extraction ─────────────────────────────────────────
SPACY_MODEL=en_core_web_sm

# ── Knowledge graph (local spaCy extraction; no LLM, no API key) ──
KNOWLEDGE_GRAPH_ENABLED=true
GRAPH_DB_PATH=./knowledge_graph.db
# Precision over recall: below this confidence an edge is discarded.
KNOWLEDGE_GRAPH_RELATIONSHIP_THRESHOLD=0.70
# RapidFuzz score (0-100) required to treat two names as one entity.
KNOWLEDGE_GRAPH_ENTITY_MERGE_THRESHOLD=92
KNOWLEDGE_GRAPH_MAX_SENTENCE_CHARS=1000
KNOWLEDGE_GRAPH_DEFAULT_LIMIT=150

# ── Embeddings ───────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Vector store ─────────────────────────────────────────────────
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=documents_4

# ── Retrieval ────────────────────────────────────────────────────
DEFAULT_TOP_K=20
DEFAULT_RERANK_TOP_K=5
RRF_K=60

# ── Context & routing ────────────────────────────────────────────
CONTEXT_TOKEN_BUDGET=2500
ROUTE_CONFIDENCE_THRESHOLD=0.9
ROUTE_COMPLEXITY_THRESHOLD=0.7

# ── Gemini (query rewriting + answer generation) ─────────────────
# Without a key, rewriting falls back to a local heuristic and answers fall
# back to extraction. Never commit the real key - this file is tracked.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1024

# ── Ollama (alternative rewriter; not wired in the composition root) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.3
